# Screens are rendered by index.php, which hands each one the session and the
# data it shows. Requested on its own, one would run with neither. Anybody who
# asks for one directly is sent to the front door instead: the opening screen
# when not signed in, the app when signed in.
<IfModule mod_alias.c>
    RedirectMatch 302 ^(.*/)pages/ $1
</IfModule>
<IfModule !mod_alias.c>
    Require all denied
</IfModule>
