# Local database credentials — never commit these.
/config/database.local.php

# Uploaded profile pictures are user content, not source.
/uploads/avatars/*
!/uploads/avatars/.gitkeep
VERSION

# Credentials for outside platforms — never commit these.
/config/integrations.local.php
/config/app.local.php
/config/auth.local.php
/config/ai.local.php

# Android / Gradle / Android Studio output, at any depth and whatever the
# Android project's folder is called — it is generated, never source, and
# anything committed is deployed.
build/
.gradle/
.kotlin/
.kotlinc/
.idea/
*.iml
local.properties
.cxx/
.externalNativeBuild/
captures/
.captures/
