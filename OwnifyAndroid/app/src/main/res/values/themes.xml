<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Dark Mode (color-scheme: dark): the window is Ownify's deepest
         ground, so nothing flashes white before the first frame. -->
    <style name="Theme.Ownify" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ownify_bg_deep</item>
        <item name="android:colorBackground">@color/ownify_bg_deep</item>
    </style>

    <!-- White Mode (color-scheme: light): set before the first frame when
         this phone chose it (MainActivity, OwnifyThemeStore), so the window,
         the splash and the system's own dialogs are light from the start. -->
    <style name="Theme.Ownify.Light" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ownify_bg_deep_light</item>
        <item name="android:colorBackground">@color/ownify_bg_deep_light</item>
        <!-- Light bars with dark icons, for a screen that does not draw
             under them itself (MainActivity sets its own, see systemBars()). -->
        <item name="android:statusBarColor">@color/ownify_bg_deep_light</item>
        <item name="android:navigationBarColor">@color/ownify_bg_deep_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Systeem, the default (OwnifyThemeStore): the phone's appearance —
         White here, Dark in values-night. The window before the first frame
         and the splash, for a phone that chose nothing; MainActivity then
         puts Theme.Ownify or Theme.Ownify.Light in place. -->
    <style name="Theme.Ownify.System" parent="Theme.Ownify.Light" />
</resources>
