<?xml version="1.0" encoding="utf-8"?>
<!-- The Ownify logo, icon-only (docs/BRANDING.md, tools/brand-icons.py): the
     symbol centred on the full logo's dark green, sized so its farthest point
     (the star) stays inside the 66 dp safe zone of every launcher mask. The
     monochrome layer is the same picture: the system uses only its shape,
     tinted, when the person has themed icons on. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ownify_logo_ground" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
